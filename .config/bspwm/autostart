#!/bin/sh

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/synx-shell"
wallpaper_file="${XDG_STATE_HOME:-$HOME/.local/state}/wallfinder/last-wallpaper"

start_once() {
    process_name="$1"
    shift
    if ! pgrep -u "$(id -u)" -x "$process_name" >/dev/null 2>&1; then
        "$@" &
    fi
}

bash "$HOME/.local/bin/synx-shell-runtime" >/dev/null 2>&1 || true

if command -v feh >/dev/null 2>&1 && [ -r "$wallpaper_file" ]; then
    feh --bg-fill "$(cat "$wallpaper_file")" >/dev/null 2>&1 &
fi

command -v picom >/dev/null 2>&1 && start_once picom picom -b
if command -v polybar >/dev/null 2>&1; then
    # A previous bspwm session may have left a stale bar process behind.
    pkill -u "$(id -u)" -x polybar >/dev/null 2>&1 || true
    polybar -c "$state_dir/polybar.ini" main >"$state_dir/polybar.log" 2>&1 &
    if command -v xdotool >/dev/null 2>&1; then
        wait_count=0
        while [ "$wait_count" -lt 30 ]; do
            xdotool search --class polybar >/dev/null 2>&1 && break
            wait_count=$((wait_count + 1))
            sleep 0.1
        done
    fi
fi
bash "$HOME/.local/bin/synx-shell-runtime" >/dev/null 2>&1 || true
if command -v dunst >/dev/null 2>&1; then
    pkill -u "$(id -u)" -x dunst >/dev/null 2>&1 || true
    dunst -config "$state_dir/dunstrc" &
fi
command -v greenclip >/dev/null 2>&1 && start_once greenclip greenclip daemon
