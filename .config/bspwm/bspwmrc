#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &

# Give each monitor a unique block of ten desktop numbers.
monitor_index=0
bspc query -M | while IFS= read -r monitor; do
    monitor_index=$((monitor_index + 1))
    desktop_names=''
    desktop_number=$(((monitor_index - 1) * 10 + 1))
    count=0
    while [ "$count" -lt 10 ]; do
        desktop_names="$desktop_names $desktop_number"
        desktop_number=$((desktop_number + 1))
        count=$((count + 1))
    done
    # Intentional word splitting supplies one desktop name per argument.
    # shellcheck disable=SC2086
    bspc monitor "$monitor" -d $desktop_names
done

bspc config border_width         2
bspc config window_gap          15
theme_file="${XDG_STATE_HOME:-$HOME/.local/state}/synx-shell/polybar-colors.ini"
focused_border="$(awk -F ' = ' '$1 == "outline" {print $2; exit}' "$theme_file" 2>/dev/null)"
normal_border="$(awk -F ' = ' '$1 == "disabled" {print $2; exit}' "$theme_file" 2>/dev/null)"
bspc config focused_border_color "${focused_border:-#ffffff}"
bspc config normal_border_color  "${normal_border:-#868686}"

bspc config split_ratio          0.52
bspc config borderless_monocle   false
bspc config gapless_monocle      false

bspc rule -a Wallfinder state=floating center=on

# Autostart Script
bash "$HOME/.config/bspwm/autostart" &
