#!/usr/bin/env bash
set -euo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
root_dir="$(cd -- "$(dirname -- "$script_path")/../.." && pwd -P)"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/synx-shell"
mkdir -p "$state_dir"

if [[ ! -s "$state_dir/polybar-colors.ini" ]]; then
    cp -- "$root_dir/.config/polybar/colors.ini" "$state_dir/polybar-colors.ini"
fi
if [[ ! -s "$state_dir/rofi-colors.rasi" ]]; then
    cp -- "$root_dir/.config/rofi/matugen-colors.rasi" "$state_dir/rofi-colors.rasi"
fi
if [[ ! -s "$state_dir/alacritty-colors.toml" ]]; then
    cp -- "$root_dir/.config/alacritty/colors.toml" "$state_dir/alacritty-colors.toml"
fi
if [[ ! -s "$state_dir/dunstrc" ]]; then
    cp -- "$root_dir/.config/dunst/dunstrc" "$state_dir/dunstrc"
fi

clock_format="12"
if [[ -r "$HOME/.config/synx-shell/clock-format" ]]; then
    clock_format="$(<"$HOME/.config/synx-shell/clock-format")"
fi
[[ "$clock_format" == 24 ]] || clock_format=12

temporary_config="$(mktemp "$state_dir/.polybar.XXXXXX")"
trap 'rm -f -- "$temporary_config"' EXIT
awk -v format="$clock_format" '
    /^\[module\/date\][[:space:]]*$/ { in_date=1; print; next }
    /^\[/ { in_date=0 }
    in_date && /^[[:space:]]*date[[:space:]]*=/ {
        if (format == 24) print "date = %H:%M"
        else print "date = %l:%M %P"
        next
    }
    in_date && /^[[:space:]]*date-alt[[:space:]]*=/ {
        if (format == 24) print "date-alt = %Y-%m-%d %H:%M:%S"
        else print "date-alt = %Y-%m-%d %I:%M:%S %p"
        next
    }
    { print }
' "$root_dir/.config/polybar/config.ini" > "$temporary_config"
chmod 644 "$temporary_config"
mv -f -- "$temporary_config" "$state_dir/polybar.ini"
trap - EXIT
