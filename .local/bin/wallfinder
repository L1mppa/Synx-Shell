#!/usr/bin/env bash
# Terminal wallpaper picker for X11/BSPWM.
# Inspired by gustahxn's Wallfinder concept and selector UI:
# https://github.com/gustahxn/wallfinder
# Synx Shell uses its own X11, feh, ueberzugpp/chafa, and Matugen implementation.
# See the repository NOTICE for attribution and the upstream MIT license.

for cmd in fzf feh notify-send python3; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "error: $cmd not found." >&2; exit 1; }
done
if ! command -v ueberzugpp >/dev/null 2>&1 && ! command -v chafa >/dev/null 2>&1; then
    echo 'error: install ueberzugpp or chafa to preview wallpapers.' >&2
    exit 1
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/wallfinder"
theme_dir="${XDG_STATE_HOME:-$HOME/.local/state}/synx-shell"
wall_dir="${WALLFINDER_DIR:-$HOME/Wallpapers}"
preview_socket=''
preview_pid_file=''
mkdir -p "$state_dir" "$theme_dir"

close_preview() {
    if [[ -n "$preview_socket" ]]; then
        ueberzugpp cmd -s "$preview_socket" -a exit >/dev/null 2>&1 || true
        preview_socket=''
    fi
    if [[ -n "$preview_pid_file" ]]; then
        rm -f -- "$preview_pid_file"
        preview_pid_file=''
    fi
}
trap close_preview EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

theme_color() {
    local key="$1" value
    value="$(awk -F '[[:space:]]*=[[:space:]]*' -v key="$key" '$1 == key {print $2; exit}' \
        "$theme_dir/polybar-colors.ini" 2>/dev/null || true)"
    [[ "$value" =~ ^#[[:xdigit:]]{6}$ ]] || value="#cccccc"
    printf '%s' "$value"
}

find_wallpapers() {
    find "$wall_dir" \( -type f -o -type l \) \( -iname '*.jpg' -o -iname '*.png' -o -iname '*.jpeg' -o -iname '*.webp' \) -print0 | sort -z
}

pick_wallpaper() {
    trap close_preview EXIT
    local result=0 primary outline disabled runtime_dir pid_file pid socket
    primary="$(theme_color primary)"
    outline="$(theme_color outline)"
    disabled="$(theme_color disabled)"

    if command -v ueberzugpp >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
        runtime_dir="${UEBERZUGPP_TMPDIR:-${TMPDIR:-/tmp}}"
        mkdir -p "$runtime_dir"
        export UEBERZUGPP_TMPDIR="$runtime_dir"
        pid_file="$(mktemp "$runtime_dir/.wallfinder-ueberzugpp.XXXXXX")"
        preview_pid_file="$pid_file"
        rm -f -- "$pid_file"

        if ueberzugpp layer --no-stdin --silent --use-escape-codes --output x11 --pid-file "$pid_file" \
            >/dev/tty 2>/dev/null \
            && [[ -s "$pid_file" ]]; then
            pid="$(<"$pid_file")"
            socket="$runtime_dir/ueberzugpp-$pid.socket"
            preview_socket="$socket"
            if WALLFINDER_UEBERZUG_SOCKET="$socket" fzf \
                --read0 --print0 \
                --delimiter='/' --with-nth=-1 \
                --prompt="select wallpaper > " \
                --layout=reverse --border \
                --color="border:$outline,prompt:$primary,pointer:$primary,marker:$primary,info:$disabled,hl:$primary,hl+:$primary" \
                --preview='ueberzugpp cmd -s "$WALLFINDER_UEBERZUG_SOCKET" -i wallfinder -a add -x "$FZF_PREVIEW_LEFT" -y "$FZF_PREVIEW_TOP" --max-width "$FZF_PREVIEW_COLUMNS" --max-height "$FZF_PREVIEW_LINES" -f {}' \
                --preview-window=right:65%:wrap \
                --header="enter to apply | esc/ctrl-c to exit" < <(find_wallpapers); then
                result=0
            else
                result=$?
            fi
            close_preview
            return "$result"
        fi
        rm -f -- "$pid_file"
        preview_pid_file=''
    fi

    if ! command -v chafa >/dev/null 2>&1; then
        echo 'error: ueberzugpp needs an X11 display for image previews; install chafa for the text fallback.' >&2
        return 1
    fi
    fzf \
        --read0 --print0 \
        --delimiter='/' --with-nth=-1 \
        --prompt="select wallpaper > " \
        --layout=reverse --border \
        --color="border:$outline,prompt:$primary,pointer:$primary,marker:$primary,info:$disabled,hl:$primary,hl+:$primary" \
        --preview='chafa --format symbols --symbols sextant+block --colors full --work 9 --scale max --size ${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES} -- {}' \
        --preview-window=right:65%:wrap \
        --header="enter to apply | esc/ctrl-c to exit" < <(find_wallpapers)
}

if [[ ! -d "$wall_dir" ]]; then
    echo "error: wallpaper directory $wall_dir not found." >&2
    exit 1
fi
if ! IFS= read -r -d '' first_image < <(find_wallpapers); then
    echo "error: no supported wallpaper images found in $wall_dir." >&2
    exit 1
fi

while true; do
    img_selection=''
    IFS= read -r -d '' img_selection < <(pick_wallpaper) || exit 0
    if [[ ! -f "$img_selection" || ! -r "$img_selection" ]]; then
        notify-send "Wallpaper unavailable" "The selected image moved or was removed. Choose another image."
        continue
    fi

    if ! feh --no-fehbg --bg-fill "$img_selection"; then
        notify-send "Wallpaper failed" "Could not apply $(basename "$img_selection")."
        continue
    fi

    printf '%s\n' "$img_selection" > "$state_dir/last-wallpaper"
    if command -v matugen >/dev/null 2>&1; then
        if ! matugen image "$img_selection" --mode dark --type scheme-fidelity --source-color-index 0 \
            --fallback-color "#ffffff" --dry-run --json hex \
            | python3 "$HOME/.local/bin/synx-theme" >/dev/null; then
            echo "Matugen palette could not be applied for: $img_selection" >&2
            notify-send "Matugen failed" "Wallpaper applied; colors were left unchanged."
        else
            outline="$(theme_color outline)"
            outline_variant="$(theme_color disabled)"
            command -v bspc >/dev/null 2>&1 && {
                bspc config focused_border_color "$outline" || true
                bspc config normal_border_color "$outline_variant" || true
            }
            command -v dunstctl >/dev/null 2>&1 && dunstctl reload >/dev/null 2>&1 || true
            command -v polybar-msg >/dev/null 2>&1 && polybar-msg cmd restart >/dev/null 2>&1 || true
        fi
    fi
    notify-send "Wallpaper applied" "$(basename "$img_selection")"
done
