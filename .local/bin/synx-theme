#!/usr/bin/env python3
"""Render a Matugen palette into Synx Shell's untracked runtime state."""

import json
import os
import re
import shutil
import sys
from pathlib import Path


home = Path.home()
state = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state")) / "synx-shell"
state.mkdir(parents=True, exist_ok=True)
payload = json.load(sys.stdin)
colors = payload.get("colors", {})
palette = colors.get("dark")
if not isinstance(palette, dict) or "source_color" not in palette:
    palette = colors


def color(name: str, fallback: str) -> str:
    value = palette.get(name, fallback)
    if isinstance(value, dict) and "color" not in value:
        value = value.get("dark", value.get("default", value))
    if isinstance(value, dict):
        value = value.get("color", fallback)
    if not isinstance(value, str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
        return fallback
    return value


source = color("source_color", "#ffffff")
rgb = tuple(int(source[index:index + 2], 16) for index in (1, 3, 5))
maximum, minimum = max(rgb), min(rgb)
neutral = maximum == 0 or (maximum - minimum) / maximum <= 0.08
outline = "#ffffff" if neutral else color("outline", "#686868")
outline_variant = color("outline_variant", outline)
primary = color("primary", "#686868")
secondary = color("secondary", primary)
surface = color("surface", "#101010")
surface_variant = color("surface_variant", "#252525")
active = color("secondary_container", surface_variant)
foreground = color("on_background", "#b9b9b9")
foreground_alt = color("on_surface", foreground)
alert = color("error", "#999999")


def unique_palette(slots, blocked):
    used = {value.lower() for value in blocked}
    result = []
    for candidate, fallback, backup in slots:
        value = candidate
        if value.lower() in used:
            value = fallback
        if value.lower() in used:
            value = backup
        if value.lower() in used:
            raise ValueError("Could not build a distinct ANSI palette")
        result.append(value)
        used.add(value.lower())
    return result


def luminance(value):
    channels = [int(value[index:index + 2], 16) / 255 for index in (1, 3, 5)]
    linear = [channel / 12.92 if channel <= 0.04045 else ((channel + 0.055) / 1.055) ** 2.4 for channel in channels]
    return sum(channel * weight for channel, weight in zip(linear, (0.2126, 0.7152, 0.0722)))


def contrast_ratio(first, second):
    light, dark = sorted((luminance(first), luminance(second)), reverse=True)
    return (light + 0.05) / (dark + 0.05)


def readable_color(candidate, background):
    rgb = [int(candidate[index:index + 2], 16) for index in (1, 3, 5)]
    for step in range(1, 13):
        amount = step / 12
        color_value = "#" + "".join(f"{round(channel + (255 - channel) * amount):02x}" for channel in rgb)
        if contrast_ratio(color_value, background) >= 4.5:
            return color_value
    return "#83a598"


normal_slots = [
    (readable_color(surface_variant, surface), "#767676", "#8a8a8a"),
    (alert, "#cc241d", "#d65d0e"),
    (secondary, "#98971a", "#689d6a"),
    (primary, "#d79921", "#fabd2f"),
    (readable_color(outline_variant, surface), "#83a598", "#8ecfff"),
    ("#d33682", "#b16286", "#e176aa"),
    ("#2aa198", "#8be9fd", "#56b6c2"),
    (foreground_alt, "#e2e2e9", "#ebdbb2"),
]
ansi_normal = unique_palette(normal_slots, {surface})

def brighten(value):
    return "#" + "".join(f"{round(int(value[index:index + 2], 16) * 0.68 + 255 * 0.32):02x}" for index in (1, 3, 5))


bright_fallbacks = [
    ("#5d5f62", "#808287"),
    ("#fb4934", "#e06c75"),
    ("#b8bb26", "#a3be8c"),
    ("#fabd2f", "#e5c07b"),
    ("#8ecfff", "#61afef"),
    ("#d3869b", "#c678dd"),
    ("#8be9fd", "#56b6c2"),
    ("#ebdbb2", "#d9c89e"),
]
ansi_bright = unique_palette(
    [(brighten(value), *bright_fallbacks[index]) for index, value in enumerate(ansi_normal)],
    {surface, *ansi_normal},
)


(state / "polybar-colors.ini").write_text(
    "[colors]\n"
    f"background = {surface}\n"
    f"background-alt = {surface_variant}\n"
    f"background-active = {active}\n"
    f"foreground = {foreground}\n"
    f"foreground-alt = {foreground_alt}\n"
    f"primary = {primary}\n"
    f"secondary = {secondary}\n"
    f"alert = {alert}\n"
    f"disabled = {outline_variant}\n"
    f"outline = {outline}\n"
)
(state / "rofi-colors.rasi").write_text(
    "* {\n"
    f"    accent: {outline};\n"
    f"    background: {surface};\n"
    f"    background-alt: {surface_variant};\n"
    f"    background-active: {active};\n"
    f"    foreground: {foreground};\n"
    f"    foreground-alt: {foreground_alt};\n"
    f"    muted: {outline_variant};\n"
    "}\n"
)
(state / "alacritty-colors.toml").write_text(
    "[colors.primary]\n"
    f'background = "{surface}"\nforeground = "{foreground}"\n\n'
    "[colors.cursor]\n"
    f'cursor = "{outline}"\ntext = "{surface}"\n\n'
    "[colors.normal]\n"
    + f'black = "{ansi_normal[0]}"\nred = "{ansi_normal[1]}"\ngreen = "{ansi_normal[2]}"\n'
    + f'yellow = "{ansi_normal[3]}"\nblue = "{ansi_normal[4]}"\nmagenta = "{ansi_normal[5]}"\n'
    + f'cyan = "{ansi_normal[6]}"\nwhite = "{ansi_normal[7]}"\n\n'
    + "[colors.bright]\n"
    + f'black = "{ansi_bright[0]}"\nred = "{ansi_bright[1]}"\ngreen = "{ansi_bright[2]}"\n'
    + f'yellow = "{ansi_bright[3]}"\nblue = "{ansi_bright[4]}"\nmagenta = "{ansi_bright[5]}"\n'
    + f'cyan = "{ansi_bright[6]}"\nwhite = "{ansi_bright[7]}"\n'
)

dunstrc = state / "dunstrc"
if not dunstrc.exists():
    source_dunstrc = home / ".config/dunst/dunstrc"
    if source_dunstrc.exists():
        shutil.copyfile(source_dunstrc, dunstrc)
if dunstrc.exists():
    text = dunstrc.read_text()
    text, _ = re.subn(
        r'(?m)^(\s*frame_color\s*=\s*)"?#[0-9a-fA-F]{6}"?\s*$',
        lambda match: f'{match.group(1)}"{outline}"',
        text,
        count=1,
    )
    text = re.sub(
        r'(?ms)(\[urgency_(?:low|normal|critical)\]\n)(.*?)(?=\n\[|\Z)',
        lambda match: match.group(1) + re.sub(
            r'(?m)^(\s*background\s*=\s*).*$',
            lambda line: f'{line.group(1)}"{surface}"',
            re.sub(
                r'(?m)^(\s*foreground\s*=\s*).*$',
                lambda line: f'{line.group(1)}"{foreground}"',
                match.group(2),
            ),
        ),
        text,
    )
    dunstrc.write_text(text)

print(outline, outline_variant)

